{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seamind",
  "version": "0.1.0",
  "identifier": "com.markmap.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Seamind",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob: https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost data: blob: https://i.ytimg.com https://yt3.googleusercontent.com https://yt3.ggpht.com; media-src 'self' asset: http://asset.localhost blob: https://*.googlevideo.com; frame-src asset: http://asset.localhost blob: https://www.youtube.com https://www.youtube-nocookie.com; style-src 'self' 'unsafe-inline' blob:; font-src 'self' data: blob:;"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/plantuml/plantuml-mit-1.2026.8.jar": "plantuml/plantuml-mit-1.2026.8.jar",
      "resources/plantuml/LICENSE.txt": "plantuml/LICENSE.txt"
    },
    "icon": ["icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "Markdown mind maps on your desktop",
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "nsis/installer.nsi",
        "installerHooks": "nsis/installer-hooks.nsh",
        "languages": ["SimpChinese", "English"],
        "customLanguageFiles": {
          "SimpChinese": "nsis/language-zh.nsh",
          "English": "nsis/language-en.nsh"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4RUFDMkY4NDUzRjJGNUIKUldSYkx6OUYrTUxxU0pSK05HeHRkYzJWN1VCN09qdjB6RjV4anlvOTFkVi9JTGFqci80aFRhbGEK",
      "endpoints": [
        "https://github.com/ltm84532430-max/Seamind/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
